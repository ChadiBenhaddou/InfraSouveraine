APP_NAME=InfraSouveraine
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TESTING_MODE=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nodataleak
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_ENCODING=utf-8
MAIL_FROM_ADDRESS="hello@nodataleak.io"
MAIL_FROM_NAME="${APP_NAME}"

RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://rest.runpod.io/v1
RUNPOD_DEFAULT_IMAGE_NAME=ghcr.io/open-webui/open-webui:ollama
RUNPOD_DEFAULT_TEMPLATE_ID=
RUNPOD_DEFAULT_VOLUME_SIZE=50
RUNPOD_WEBUI_PORT=8080
RUNPOD_WEBHOOK_SECRET=

AI_RECOMMENDER_API_KEY=
AI_RECOMMENDER_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_RECOMMENDER_MODEL=gpt-4o-mini

STORAGE_COST_PER_GB_MONTHLY=0.10
DEFAULT_BENEFIT_MARGIN=0.35
FIXED_PLATFORM_MARKUP=9.99
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
TRUSTED_PROXIES=*
